# Where the frontend sends API calls. Keep it "/api": locally Vite forwards /api to the backend on
# localhost:8000, and on Vercel vercel.json forwards /api to Render. Same-site /api is what lets the
# login session live in a secure HttpOnly cookie (a different site's cookie would be blocked).
VITE_API_BASE_URL=/api

# Supabase (auth + storage). Leave blank to keep the mock auth adapter running.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to "mock" to run entirely on sample data, "live" to hit the API.
VITE_DATA_SOURCE=mock

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave blank locally; set it on Vercel.
VITE_GA_MEASUREMENT_ID=
